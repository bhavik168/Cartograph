# Primary provider. Cartographer routes all traffic here first.
ANTHROPIC_API_KEY=

# Optional fallback provider. If set, Cartographer fails over to OpenAI when
# Anthropic errors out, rate-limits, or when ANTHROPIC_API_KEY is missing.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# CARTOGRAPHER_CHEAP_MODEL=claude-haiku-4-5-20251001
# CARTOGRAPHER_STRONG_MODEL=claude-sonnet-4-5-20250929
# CARTOGRAPHER_OPENAI_CHEAP_MODEL=gpt-4o-mini
# CARTOGRAPHER_OPENAI_STRONG_MODEL=gpt-4o

# Off by default: the fetch_url tool reaches the public internet.
# CARTOGRAPHER_ENABLE_FETCH_URL=0

# cartograph-mcp, the research graph as an MCP server (see README).
# Required: the only directory the server may read documents from.
# CARTOGRAPH_MCP_CORPUS_ROOT=
# CARTOGRAPH_MCP_RUNS_ROOT=runs
# CARTOGRAPH_MCP_MAX_USD=0.50          # per-run ceiling; callers can only lower it
# CARTOGRAPH_MCP_TOTAL_MAX_USD=5.00    # per server process
# CARTOGRAPH_MCP_MAX_CONCURRENT_RUNS=2
# CARTOGRAPH_MCP_ENABLE_FETCH_URL=0    # overrides CARTOGRAPHER_ENABLE_FETCH_URL inside the server
